# =============================================================================
# Config nginx de horuservices.cloud  ->  /etc/nginx/sites-enabled/horuservices
#
# Ce fichier est la copie DE REFERENCE de la config en place (resynchronisee le
# 2026-10-03 : l'ancienne copie du depot avait derive, sans bloc HTTPS certbot ni
# CSP). Il n'est PAS deploye par la CI : il faut un sudo.
#
# Application (apres avoir relu le diff) :
#   sudo cp /etc/nginx/sites-enabled/horuservices ~/horuservices.nginx.bak
#   sudo cp /var/www/horusglobalservices/horusglobalservices/nginx /etc/nginx/sites-enabled/horuservices
#   sudo nginx -t && sudo systemctl reload nginx
# Retour arriere : recopier ~/horuservices.nginx.bak puis nginx -t et reload.
#
# NB : sites-available/horuservices est une vieille copie, seule la version de
# sites-enabled est lue par nginx (fichier regulier, pas un lien symbolique).
# =============================================================================

# 1. BLOC PAR DEFAUT : Rejette les acces directs par IP
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# 2. BLOC PRINCIPAL
server {
    server_name horuservices.cloud www.horuservices.cloud;

    client_max_body_size 20M;

    # ===== HEADERS SECURITE =====
    # disabled by security audit on 2026-07-04: header already set by upstream app
    # add_header X-Frame-Options "DENY" always;
    # disabled by security audit on 2026-07-04: header already set by upstream app
    # add_header X-Content-Type-Options "nosniff" always;
    # disabled by security audit on 2026-07-04: header already set by upstream app
    # add_header Referrer-Policy "same-origin" always;
    # disabled by security audit on 2026-07-04: header already set by upstream app
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()" always;
    # Google Analytics 4 autorise (script-src + connect-src) : memes hotes que CSP_DIRECTIVES dans
    # config/settings.py (les deux politiques s'additionnent : il faut les deux). GA ne se charge
    # qu'apres consentement (bandeau cookies). Cloudflare Web Analytics (balise injectee par
    # Cloudflare, sans cookie) est autorise aussi : static.cloudflareinsights.com pour le script,
    # cloudflareinsights.com pour l'envoi des mesures.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://static.cloudflareinsights.com https://fonts.googleapis.com https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://cloudflareinsights.com; frame-ancestors 'none';" always;

    # Logs
    access_log /var/www/horusglobalservices/horusglobalservices/logs/nginx-access.log;
    error_log /var/www/horusglobalservices/horusglobalservices/logs/nginx-error.log;

    # Favicon : servi directement depuis les statiques.
    # Un "location =" sans alias ni proxy_pass faisait chercher le fichier dans la
    # racine par defaut de nginx : 404, la requete n'atteignait jamais Django.
    location = /favicon.ico {
        alias /var/www/horusglobalservices/horusglobalservices/staticfiles/favicon.ico;
        access_log off;
        log_not_found off;
        expires 30d;
    }

    # robots.txt : PAS de bloc dedie. Il est genere par Django
    # (config/urls.py -> templates/robots.txt) et doit donc passer par
    # location / vers Gunicorn. L'ancien "location = /robots.txt { ... }" vide
    # le masquait : nginx repondait 404 et le Sitemap n'etait jamais annonce.

    # Fichiers statiques
    location /static/ {
        alias /var/www/horusglobalservices/horusglobalservices/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    # Fichiers media
    location /media/ {
        alias /var/www/horusglobalservices/horusglobalservices/media/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    # Bloquer fichiers caches (.env, .git, etc.)
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Proxy vers Django (Gunicorn)
    location / {
        include proxy_params;
        proxy_pass http://unix:/var/www/horusglobalservices/horusglobalservices/horus.sock;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/horuservices.cloud/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/horuservices.cloud/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.horuservices.cloud) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = horuservices.cloud) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    server_name horuservices.cloud www.horuservices.cloud;
    return 404; # managed by Certbot
}
