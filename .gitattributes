# Normalisation des fins de ligne.
# Sans cette regle, git sur Windows peut livrer deploy.sh en CRLF : le serveur
# Linux echoue alors avec "\r: command not found" des la premiere ligne.
* text=auto

*.sh   text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
